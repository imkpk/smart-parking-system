generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider          = "postgresql"
  url               = env("DATABASE_URL")
  shadowDatabaseUrl = env("SHADOW_DATABASE_URL")
}

enum Role {
  SUPER_ADMIN
  TENANT_ADMIN
  ADMIN
  SECURITY
  USER
}

enum OrganizationPlan {
  FREE
  STARTER
  PRO
  ENTERPRISE
}

enum SlotStatus {
  AVAILABLE
  OCCUPIED
  RESERVED
  MAINTENANCE
}

enum ParkingLotType {
  APARTMENT
  MALL
  HOSPITAL
  OFFICE
  PUBLIC
}

enum ParkingLotVisibility {
  PRIVATE
  PUBLIC
  INVITE_ONLY
}

enum SlotType {
  CAR
  BIKE
  EV
  HANDICAPPED
}

enum VehicleType {
  CAR
  BIKE
  EV
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
  EXPIRED
}

enum ParkingEventStatus {
  ACTIVE
  COMPLETED
  CANCELLED
}

enum AssignmentStatus {
  ACTIVE
  REVOKED
}

enum OutboxEventStatus {
  PENDING
  PROCESSING
  PROCESSED
  FAILED
}

enum OutboxEventType {
  PARKING_CHECKED_IN
  PARKING_CHECKED_OUT
  BOOKING_CREATED
  BOOKING_CANCELLED
  PAYMENT_VERIFIED
  NOTIFICATION_REQUESTED
  GATE_OPEN_REQUESTED
  GATE_COMMAND_PUBLISHED
  GATE_COMMAND_EXECUTED
  GATE_COMMAND_FAILED
  IOT_DEVICE_STATUS_CHANGED
  GENERIC
}

enum GateDirection {
  ENTRY
  EXIT
  BIDIRECTIONAL
}

enum IotDeviceType {
  EDGE_GATEWAY
  ANPR_CAMERA
  RFID_READER
  QR_READER
  BARRIER_CONTROLLER
}

enum IotDeviceStatus {
  ONLINE
  OFFLINE
  DEGRADED
  DISABLED
}

enum VehicleCredentialType {
  UHF_RFID
  QR_CODE
}

enum VehicleCredentialStatus {
  ACTIVE
  REVOKED
  EXPIRED
}

enum GateIdentifierType {
  PLATE
  UHF_RFID
  QR_CODE
}

enum GateAccessSource {
  ANPR
  RFID
  QR
  MANUAL_OVERRIDE
}

enum GateAccessDecision {
  GRANTED
  DENIED
  REVIEW_REQUIRED
  ERROR
}

enum GateCommandAction {
  OPEN
}

enum GateCommandStatus {
  PENDING
  PUBLISHED
  ACKNOWLEDGED
  EXECUTED
  FAILED
  EXPIRED
}

enum ConversationType {
  SECURITY
  CUSTOMER_CARE
}

enum ConversationStatus {
  OPEN
  RESOLVED
}

model Organization {
  id                   Int                   @id @default(autoincrement())
  name                 String
  slug                 String                @unique
  organizationType     ParkingLotType        @default(APARTMENT) @map("organization_type")
  logoUrl              String?
  primaryColor         String?
  secondaryColor       String?
  accentColor          String?
  loginTitle           String?
  supportEmail         String?
  plan                 OrganizationPlan      @default(FREE)
  maxParkingLots       Int                   @default(5) @map("maxLots")
  maxUsers             Int                   @default(50)
  isActive             Boolean               @default(true)
  users                User[]
  parkingLots          ParkingLot[]
  vehicles             Vehicle[]
  bookings             Booking[]
  parkingEvents        ParkingEvent[]
  assignments          SlotAssignment[]
  conversations        Conversation[]
  conversationMessages ConversationMessage[]
  gates                Gate[]
  iotDevices           IotDevice[]
  gateDetections       GateDetection[]
  gateAccessAttempts   GateAccessAttempt[]
  gateCommands         GateCommand[]
  vehicleCredentials   VehicleAccessCredential[]
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt

  @@map("organizations")
}

model User {
  id                       Int                   @id @default(autoincrement())
  organizationId           Int?
  name                     String
  email                    String?
  phone                    String?
  passwordHash             String
  passwordResetToken       String?               @unique
  passwordResetExpiresAt   DateTime?
  role                     Role                  @default(USER)
  isActive                 Boolean               @default(true)
  organization             Organization?         @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  vehicles                 Vehicle[]
  bookings                 Booking[]
  parkingEvents            ParkingEvent[]
  assignments              SlotAssignment[]
  createdConversations     Conversation[]        @relation("ConversationCreatedBy")
  assignedConversations    Conversation[]        @relation("ConversationAssignedTo")
  sentConversationMessages ConversationMessage[] @relation("ConversationMessageSender")
  createdAt                DateTime              @default(now())
  updatedAt                DateTime              @updatedAt

  @@unique([organizationId, email])
  @@unique([organizationId, phone])
  @@index([organizationId])
  @@map("users")
}

model ParkingLot {
  id             Int                  @id @default(autoincrement())
  organizationId Int
  name           String
  type           ParkingLotType       @default(APARTMENT)
  address        String?
  city           String?
  state          String?
  pincode        String?
  visibility     ParkingLotVisibility @default(PRIVATE)
  latitude       Decimal?             @db.Decimal(10, 7)
  longitude      Decimal?             @db.Decimal(10, 7)
  baseHourlyRate Decimal?             @db.Decimal(10, 2)
  currency       String?              @default("INR")
  openingHours   String?
  isActive       Boolean              @default(true)
  organization   Organization         @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  floors         Floor[]
  bookings       Booking[]
  parkingEvents  ParkingEvent[]
  conversations  Conversation[]
  gates          Gate[]
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  @@index([organizationId])
  @@index([visibility])
  @@index([city])
  @@index([type])
  @@index([isActive])
  @@map("parking_lots")
}

model Floor {
  id           Int        @id @default(autoincrement())
  name         String
  level        Int?
  parkingLotId Int
  parkingLot   ParkingLot @relation(fields: [parkingLotId], references: [id], onDelete: Cascade)
  slots        Slot[]
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@unique([parkingLotId, name])
  @@index([parkingLotId])
  @@map("floors")
}

model Slot {
  id          Int              @id @default(autoincrement())
  slotNumber  String
  slotType    SlotType         @default(CAR) @map("type")
  status      SlotStatus       @default(AVAILABLE)
  floorId     Int
  floor       Floor            @relation(fields: [floorId], references: [id], onDelete: Cascade)
  assignments SlotAssignment[]
  events      ParkingEvent[]
  bookings    Booking[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@unique([floorId, slotNumber])
  @@index([floorId])
  @@index([status])
  @@map("parking_slots")
}

model Vehicle {
  id             Int              @id @default(autoincrement())
  organizationId Int
  userId         Int              @map("ownerId")
  vehicleNumber  String           @map("registrationNo")
  vehicleType    VehicleType      @default(CAR) @map("type")
  brand          String?          @map("make")
  model          String?
  color          String?
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  assignments    SlotAssignment[]
  events         ParkingEvent[]
  bookings       Booking[]
  credentials    VehicleAccessCredential[]
  gateDetections GateDetection[]
  gateAttempts   GateAccessAttempt[]
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@unique([organizationId, vehicleNumber])
  @@index([userId], map: "vehicles_ownerId_idx")
  @@index([organizationId])
  @@map("vehicles")
}

model Booking {
  id             Int            @id @default(autoincrement())
  organizationId Int
  userId         Int
  vehicleId      Int
  slotId         Int
  parkingLotId   Int
  status         BookingStatus  @default(CONFIRMED)
  startTime      DateTime
  endTime        DateTime?
  bookingCode    String         @unique
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  vehicle        Vehicle        @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  slot           Slot           @relation(fields: [slotId], references: [id], onDelete: Cascade)
  parkingLot     ParkingLot     @relation(fields: [parkingLotId], references: [id], onDelete: Cascade)
  parkingEvents  ParkingEvent[]
  conversations  Conversation[]
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([organizationId])
  @@index([userId])
  @@index([vehicleId])
  @@index([slotId])
  @@index([parkingLotId])
  @@index([status])
  @@map("bookings")
}

model SlotAssignment {
  id             Int              @id @default(autoincrement())
  organizationId Int
  userId         Int
  vehicleId      Int
  slotId         Int
  status         AssignmentStatus @default(ACTIVE)
  assignedAt     DateTime         @default(now())
  revokedAt      DateTime?
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  vehicle        Vehicle          @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  slot           Slot             @relation(fields: [slotId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([userId])
  @@index([vehicleId])
  @@index([slotId])
  @@index([status])
  @@map("slot_assignments")
}

model ParkingEvent {
  id              Int                @id @default(autoincrement())
  organizationId  Int
  bookingId       Int
  userId          Int
  vehicleId       Int
  slotId          Int
  parkingLotId    Int
  checkInTime     DateTime
  checkOutTime    DateTime?
  status          ParkingEventStatus @default(ACTIVE)
  durationMinutes Int?
  feeAmount       Decimal?           @db.Decimal(10, 2)
  organization    Organization       @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  booking         Booking            @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  user            User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  vehicle         Vehicle            @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  slot            Slot               @relation(fields: [slotId], references: [id], onDelete: Cascade)
  parkingLot      ParkingLot         @relation(fields: [parkingLotId], references: [id], onDelete: Cascade)
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  @@unique([bookingId])
  @@index([organizationId])
  @@index([userId])
  @@index([vehicleId])
  @@index([slotId])
  @@index([parkingLotId])
  @@index([status])
  @@map("parking_events")
}

model Conversation {
  id               Int                @id @default(autoincrement())
  organizationId   Int
  type             ConversationType
  status           ConversationStatus @default(OPEN)
  subject          String?
  createdByUserId  Int
  assignedToUserId Int?
  parkingLotId     Int?
  bookingId        Int?
  lastMessageAt    DateTime?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  organization   Organization          @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  createdByUser  User                  @relation("ConversationCreatedBy", fields: [createdByUserId], references: [id], onDelete: Cascade)
  assignedToUser User?                 @relation("ConversationAssignedTo", fields: [assignedToUserId], references: [id], onDelete: SetNull)
  parkingLot     ParkingLot?           @relation(fields: [parkingLotId], references: [id], onDelete: SetNull)
  booking        Booking?              @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  messages       ConversationMessage[]

  @@index([organizationId])
  @@index([type])
  @@index([status])
  @@index([createdByUserId])
  @@index([assignedToUserId])
  @@index([parkingLotId])
  @@index([bookingId])
  @@map("conversations")
}

model ConversationMessage {
  id             Int      @id @default(autoincrement())
  organizationId Int
  conversationId Int
  senderId       Int
  body           String   @db.Text
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation("ConversationMessageSender", fields: [senderId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([conversationId])
  @@index([senderId])
  @@map("conversation_messages")
}

model OutboxEvent {
  id             Int               @id @default(autoincrement())
  eventId        String            @unique @default(uuid())
  organizationId Int?
  eventType      OutboxEventType
  aggregateType  String?
  aggregateId    String?
  payload        Json
  status         OutboxEventStatus @default(PENDING)
  attempts       Int               @default(0)
  maxAttempts    Int               @default(5)
  nextRunAt      DateTime          @default(now())
  lockedAt       DateTime?
  lockedBy       String?
  processedAt    DateTime?
  lastError      String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@index([status, nextRunAt])
  @@index([organizationId])
  @@index([eventType])
  @@index([aggregateType, aggregateId])
  @@map("outbox_events")
}

model Gate {
  id                       Int            @id @default(autoincrement())
  organizationId           Int
  parkingLotId             Int
  externalId               String
  name                     String
  direction                GateDirection  @default(ENTRY)
  isActive                 Boolean        @default(true)
  autoOpenEnabled          Boolean        @default(true)
  anprConfidenceThreshold  Float          @default(0.85)
  duplicateWindowSeconds   Int            @default(30)
  commandTtlSeconds        Int            @default(15)
  organization             Organization   @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  parkingLot               ParkingLot     @relation(fields: [parkingLotId], references: [id], onDelete: Cascade)
  devices                  IotDevice[]
  detections               GateDetection[]
  accessAttempts           GateAccessAttempt[]
  commands                 GateCommand[]
  createdAt                DateTime       @default(now())
  updatedAt                DateTime       @updatedAt

  @@unique([organizationId, externalId])
  @@index([organizationId])
  @@index([parkingLotId])
  @@map("gates")
}

model IotDevice {
  id                 Int             @id @default(autoincrement())
  organizationId     Int
  gateId             Int
  externalDeviceId   String
  name               String
  deviceType         IotDeviceType
  status             IotDeviceStatus @default(OFFLINE)
  isEnabled          Boolean         @default(true)
  credentialHash     String?
  lastSeenAt         DateTime?
  firmwareVersion    String?
  metadata           Json?
  organization       Organization    @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  gate               Gate            @relation(fields: [gateId], references: [id], onDelete: Cascade)
  detections         GateDetection[]
  commands           GateCommand[]   @relation("ControllerDevice")
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  @@unique([organizationId, externalDeviceId])
  @@index([organizationId])
  @@index([gateId])
  @@index([status])
  @@map("iot_devices")
}

model VehicleAccessCredential {
  id              Int                     @id @default(autoincrement())
  organizationId  Int
  vehicleId       Int
  credentialType  VehicleCredentialType
  credentialHash  String
  displaySuffix   String
  status          VehicleCredentialStatus @default(ACTIVE)
  validFrom       DateTime                @default(now())
  validUntil      DateTime?
  createdByUserId Int?
  organization    Organization            @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  vehicle         Vehicle                 @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt

  @@unique([organizationId, credentialHash])
  @@index([organizationId, vehicleId])
  @@index([status])
  @@map("vehicle_access_credentials")
}

model GateDetection {
  id                Int                @id @default(autoincrement())
  organizationId    Int
  gateId            Int
  deviceId          Int
  messageId         String
  identifierType    GateIdentifierType
  identifierHash    String?
  identifierDisplay String?
  confidence        Float?
  occurredAt        DateTime
  receivedAt        DateTime           @default(now())
  matchedVehicleId  Int?
  organization      Organization       @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  gate              Gate               @relation(fields: [gateId], references: [id], onDelete: Cascade)
  device            IotDevice          @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  matchedVehicle    Vehicle?           @relation(fields: [matchedVehicleId], references: [id], onDelete: SetNull)
  accessAttempts    GateAccessAttempt[]
  createdAt         DateTime           @default(now())

  @@unique([deviceId, messageId])
  @@index([organizationId, gateId, occurredAt])
  @@index([gateId, occurredAt])
  @@map("gate_detections")
}

model GateAccessAttempt {
  id              Int                @id @default(autoincrement())
  attemptId       String             @unique @default(uuid())
  organizationId  Int
  gateId          Int
  detectionId     Int?
  source          GateAccessSource
  decision        GateAccessDecision
  reasonCode      String
  reasonDetail    String?
  vehicleId       Int?
  bookingId       Int?
  parkingEventId  Int?
  commandId       String?
  actorUserId     Int?
  organization    Organization       @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  gate            Gate               @relation(fields: [gateId], references: [id], onDelete: Cascade)
  detection       GateDetection?     @relation(fields: [detectionId], references: [id], onDelete: SetNull)
  vehicle         Vehicle?           @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  commands        GateCommand[]
  createdAt       DateTime           @default(now())

  @@index([organizationId, gateId, createdAt])
  @@index([gateId, createdAt])
  @@map("gate_access_attempts")
}

model GateCommand {
  id                  Int               @id @default(autoincrement())
  commandId           String            @unique @default(uuid())
  organizationId      Int
  gateId              Int
  controllerDeviceId  Int
  accessAttemptId     Int
  action              GateCommandAction @default(OPEN)
  status              GateCommandStatus @default(PENDING)
  requestedAt         DateTime          @default(now())
  publishedAt         DateTime?
  acknowledgedAt      DateTime?
  executedAt          DateTime?
  expiresAt           DateTime
  failureCode         String?
  failureMessage      String?
  organization        Organization      @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  gate                Gate              @relation(fields: [gateId], references: [id], onDelete: Cascade)
  controllerDevice    IotDevice         @relation("ControllerDevice", fields: [controllerDeviceId], references: [id], onDelete: Cascade)
  accessAttempt       GateAccessAttempt @relation(fields: [accessAttemptId], references: [id], onDelete: Cascade)
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  @@index([organizationId, gateId, status])
  @@index([gateId, status, expiresAt])
  @@index([controllerDeviceId, status])
  @@map("gate_commands")
}
